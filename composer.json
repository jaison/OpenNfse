{
  "name": "whmcs-addon/opennfse",
  "type": "project",
  "require": {
    "php": "^8.1",
    "nfse-nacional/nfse-php": "dev-main#a9bdf8cc58c333b4bbda791fd20ab77cfdcabab3",
    "paseto/nfse-nacional-pdf": "^0.5",
    "symfony/polyfill-intl-normalizer": "^1.38"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.13.6",
    "humbug/php-scoper": "^0.18",
    "cweagans/composer-patches": "1.7.3"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "OpenNfse\\": "src/",
      "NfsePdf\\": "src/PasetoOverrides/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenNfse\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/Stubs"
    ]
  },
  "scripts": {
    "cs:check": "phpcs -p",
    "cs:fix": "phpcbf -p",
    "test": "phpunit -c phpunit.xml",
    "scope": [
      "php -d memory_limit=1G vendor/bin/php-scoper add-prefix --output-dir=build/scoped --force --quiet",
      "php tools/build-scoped-vendor.php",
      "@php -r \"array_map('unlink', glob(__DIR__.'/build/scoped/*') ?: []); @rmdir('build/scoped'); @rmdir('build');\""
    ]
  },
  "config": {
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  },
  "extra": {
    "composer-exit-on-patch-failure": true,
    "patches": {
      "nfse-nacional/nfse-php": {
        "01 vServMoeda com duas casas decimais (TSDec15V2)": "patches/nfse-php-01-vservmoeda-duas-casas.patch",
        "02 Religa a verificação TLS (Catanduva por nome + CURLOPT_RESOLVE)": "patches/nfse-php-02-tls-verificacao.patch",
        "03 Connect timeout de 10s": "patches/nfse-php-03-connect-timeout.patch",
        "04 Ordem de xDescServ e finNFSe no leiaute da NT 009": "patches/nfse-php-04-nt009-ordem-campos.patch"
      }
    }
  }
}
